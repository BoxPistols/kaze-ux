          "control": "select",
          "options": ["outlined", "contained", "text"]
        },
        "multiple": {
          "control": "boolean"
        },
        "fullWidth": {
          "control": "boolean"
        },
        "disabled": {
          "control": "boolean"
        }
      }
    },
