          "control": "select",
          "options": [
            "inherit",
            "primary",
            "secondary",
            "error",
            "warning",
            "info",
            "success"
          ]
        },
        "size": {
          "control": "select",
          "options": ["small", "medium", "large"]
        },
        "disabled": {
          "control": "boolean"
        },
        "fullWidth": {
          "control": "boolean"
        }
      }
    },
