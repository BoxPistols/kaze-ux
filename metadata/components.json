{
  "$schema": "https://kaze-ux.dev/schema/components.json",
  "$description": "生成物。手で編集しない（pnpm export-metadata）。story が単一ソースで、禁止事項などは metadata/curated.json で重ねる",
  "version": "2.0.0",
  "framework": "React + MUI + Tailwind CSS",
  "components": {
    "accordion": {
      "name": "Accordion",
      "category": "UI",
      "story": "Components/UI/Accordion",
      "storyFile": "src/stories/04-Components/UI/Accordion/Accordion.stories.tsx",
      "import": "@/components/ui/accordion",
      "description": "カスタムアコーディオン。アイコン、バッジ、ネスト対応のExpandable/Collapsibleパネルコンポーネント。",
      "accessibility": ["role=button", "aria-expanded", "keyboard navigation"],
      "props": {
        "highlight": {
          "control": "boolean",
          "description": "ハイライト表示"
        },
        "canExpand": {
          "control": "boolean",
          "description": "展開可能かどうか"
        },
        "defaultExpanded": {
          "control": "boolean",
          "description": "初期展開状態"
        }
      }
    },
    "actionMenu": {
      "name": "ActionMenu",
      "category": "UI/Menu",
      "story": "Components/UI/Menu/ActionMenu",
      "storyFile": "src/stories/04-Components/UI/Menu/ActionMenu.stories.tsx",
      "import": "@/components/ui/menu/actionMenu",
      "description": "3点ドットメニュー形式のアクションメニュー。テーブル行やカードのコンテキストメニューとして使用。danger指定で削除等の危険操作を視覚的に区別する。",
      "accessibility": [
        "aria-label",
        "aria-controls",
        "aria-expanded",
        "aria-haspopup"
      ],
      "sample": "<ActionMenu items={[{ id: 'edit', label: '編集', onClick: () => {} }]} ariaLabel='操作' />",
      "props": {}
    },
    "alert": {
      "name": "Alert",
      "category": "UI",
      "story": "Components/UI/Alert",
      "storyFile": "src/stories/04-Components/UI/Alert/Alert.stories.tsx",
      "import": "@mui/material",
      "description": "MUI Alertコンポーネント。standard/outlined/filledバリアント、4段階の重要度、カスタムborderRadiusとカラーテーマが適用されている。",
      "variants": ["standard", "outlined", "filled"],
      "sample": "<Alert severity='warning' variant='outlined'>保存されていません</Alert>",
      "prohibited": [
        "アプリ（apps/* と src/pages）から直接 import しない。DS の CustomToaster を使う"
      ],
      "props": {
        "severity": {
          "control": "select",
          "options": ["success", "error", "warning", "info"]
        },
        "variant": {
          "control": "select",
          "options": ["standard", "outlined", "filled"]
        }
      }
    },
    "badge": {
      "name": "Badge",
      "category": "UI",
      "story": "Components/UI/Badge",
      "storyFile": "src/stories/04-Components/UI/Badge/Badge.stories.tsx",
      "import": "@mui/material",
      "variants": ["standard", "dot"],
      "sample": "<Badge badgeContent={4} color='primary' max={99}><MailIcon /></Badge>",
      "props": {
        "badgeContent": {
          "control": "number"
        },
        "color": {
          "control": "select",
          "options": [
            "default",
            "primary",
            "secondary",
            "error",
            "info",
            "success",
            "warning"
          ]
        },
        "variant": {
          "control": "select",
          "options": ["standard", "dot"]
        },
