{
  "name": "kaze-ux",
  "repository": {
    "type": "git",
    "url": "https://github.com/BoxPistols/kaze-ux.git"
  },
  "private": false,
  "description": "MUI + Tailwind + Storybook のデザインシステム。トークンと部品の仕様を AI が読める形で配り、守られていることを実測で検査する",
  "keywords": [
    "react",
    "mui",
    "theme",
    "components",
    "ui",
    "design-system",
    "storybook",
    "tailwindcss",
    "design-tokens",
    "mcp",
    "ai-agent",
    "accessibility",
    "wcag"
  ],
  "author": "",
  "license": "MIT",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "pnpm dev & pnpm storybook & pnpm -F saas-dashboard dev & pnpm -F kaze-eats dev & pnpm -F sky-kaze dev & wait",
    "dev:docs": "pnpm dev & pnpm storybook & wait",
    "build": "echo 'Build skipped - using source files directly'",
    "build-sandbox": "vite build --mode sandbox",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:all": "vitest run --coverage --reporter=basic --reporter=html",
    "test:all:ui": "vitest --ui --coverage --reporter=basic --reporter=html",
    "test:all:watch": "vitest --coverage --reporter=basic",
    "format": "prettier --write .",
    "lint": "eslint --fix ./src ./scripts",
    "fix": "pnpm run lint && pnpm run format",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6007",
    "prebuild-storybook": "node scripts/ds-adoption.mjs --json",
    "build-storybook": "storybook build",
    "postbuild-storybook": "node scripts/sanitize-manifests.mjs",
    "build-all": "pnpm run build-storybook",
    "build:gh-pages": "vite build --mode gh-pages",
    "build:gh-pages:storybook": "storybook build -o gh-pages/storybook",
    "build:gh-pages:all": "pnpm run build:gh-pages:storybook && pnpm run build:gh-pages:dashboard && pnpm run build:gh-pages:kaze-eats && pnpm run build:gh-pages:sky-kaze",
    "prepare": "husky",
    "export-tokens": "tsx scripts/export-design-tokens.ts",
    "export-tokens:auto": "npx tsx packages/system-design-export/src/cli.ts --from mui --input src/themes/theme.ts",
    "figma-plugin:build": "esbuild figma-plugin/code.ts --bundle --outfile=figma-plugin/code.js --target=es2017 --format=iife",
    "figma-plugin:watch": "esbuild figma-plugin/code.ts --bundle --outfile=figma-plugin/code.js --target=es2017 --format=iife --watch",
    "figma:sync": "pnpm export-tokens && pnpm figma-plugin:build",
    "push-tokens-to-figma": "tsx scripts/push-tokens-to-figma.ts",
    "storybook:capture": "tsx scripts/storybook-capture.ts",
    "dev:dashboard": "pnpm --filter saas-dashboard dev",
    "dev:kaze-eats": "pnpm --filter kaze-eats dev",
    "build:dashboard": "pnpm --filter saas-dashboard build",
    "build:kaze-eats": "pnpm --filter kaze-eats build",
    "build:gh-pages:dashboard": "pnpm --filter saas-dashboard build:gh-pages",
    "build:gh-pages:kaze-eats": "pnpm --filter kaze-eats build:gh-pages",
    "preview:dashboard": "pnpm --filter saas-dashboard preview",
    "preview:kaze-eats": "pnpm --filter kaze-eats preview",
    "test:dashboard": "pnpm --filter saas-dashboard test",
    "test:kaze-eats": "pnpm --filter kaze-eats test",
    "dev:sky-kaze": "pnpm --filter sky-kaze dev",
    "build:sky-kaze": "pnpm --filter sky-kaze build",
    "build:gh-pages:sky-kaze": "pnpm --filter sky-kaze build:gh-pages",
    "preview:sky-kaze": "pnpm --filter sky-kaze preview",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "check:brand": "node scripts/check-brand-terms.mjs",
    "ds:adoption": "node scripts/ds-adoption.mjs",
    "check:ds-core": "node scripts/check-ds-core.mjs",
    "export-css": "tsx scripts/export-css-vars.ts",
    "check:css-vars": "tsx scripts/check-css-vars.ts",
    "ds:adoption:json": "node scripts/ds-adoption.mjs --json",
    "capture:products": "node scripts/capture-products.mjs",
    "check:anon": "node scripts/check-anonymity.mjs",
    "check:live": "node scripts/check-live-secrets.mjs",
    "check:typo": "node scripts/check-rendered-typography.mjs",
    "serve:dist": "npx --yes http-server dist -p 6110 --silent",
    "vrt": "node scripts/vrt.mjs",
    "check:share": "pnpm run check:anon && pnpm run check:live",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:tailwind-consumer": "tsx scripts/check-tailwind-consumer.ts",
    "export-metadata": "node scripts/export-component-metadata.mjs",
    "check:mcp": "node scripts/check-mcp.mjs",
    "check:rules": "node scripts/check-ds-rules.mjs",
    "export-rules": "node scripts/export-prohibited-doc.mjs",
    "check:quickref": "tsx scripts/check-quickref.ts",
    "check:ga": "node scripts/check-ga.mjs",
    "check:shortcuts": "node scripts/check-storybook-shortcuts.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "sync:mcp-data": "node scripts/sync-mcp-data.mjs",
    "check:mcp-package": "node scripts/check-mcp-package.mjs"
  },
  "peerDependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/material": "^7.2.0",
    "@mui/system": "^7.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.111",
    "@ai-sdk/openai": "^3.0.99",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mapbox/togeojson": "^0.16.2",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "7.0.1-beta.25",
    "@mui/system": "^7.3.11",
    "@mui/x-data-grid": "^8.29.2",
    "@mui/x-date-pickers": "^8.29.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@turf/turf": "^7.4.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/react-router-dom": "^5.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.261",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.577.0",
    "map-or-similar": "^1.5.0",
    "mapbox-gl": "^3.29.0",
    "maplibre-gl": "^4.7.1",
    "memoizerific": "^1.11.3",
    "prism-react-renderer": "^2.4.1",
    "prop-types": "^15.8.1",
    "rbush": "^4.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "sass": "^1.103.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^9.39.5",
    "@figma/plugin-typings": "^1.134.0",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/theming": "^8.6.14",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^20.19.43",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.5.10",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^15.5.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react-map-gl": "^7.1.9",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm run lint"
    ],
    "*.{css,scss,json,md}": [
      "pnpm run format"
    ]
  },
  "packageManager": "pnpm@10.2.1",
  "volta": {
    "node": "22.14.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.2",
      "@isaacs/brace-expansion": "^5.0.1",
      "minimatch@<10": "^3.1.4",
      "minimatch@>=10": "^10.2.3",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "@xmldom/xmldom": "^0.8.12",
      "lodash": "^4.18.0",
      "picomatch@<4": "^2.3.2",
      "picomatch@>=4": "^4.0.4"
    }
  },
  "homepage": "https://kaze-ux.vercel.app",
  "bugs": {
    "url": "https://github.com/BoxPistols/kaze-ux/issues"
  }
}
