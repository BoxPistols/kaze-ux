{
  "description": "編集のたびに Kaze DS 禁止パターンへ照合し、違反をその場でエージェントに差し戻す",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-prohibited.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
